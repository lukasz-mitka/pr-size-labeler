{
  "name": "pr-size-labeler",
  "version": "1.0.0",
  "private": true,
  "description": "Label pull requests based on the number of changed lines",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/main.js --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.cjs",
    "pretest": "npm run build",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  }
}
